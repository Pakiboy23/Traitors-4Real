{
  "name": "traitors-fantasy-draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "native:web:build": "node scripts/build-native-web.mjs",
    "ios:sync:bundled": "npm run native:web:build && CAPACITOR_BUNDLED=1 npx cap sync ios",
    "android:sync:bundled": "npm run native:web:build && CAPACITOR_BUNDLED=1 npx cap sync android",
    "ios:open": "npx cap open ios",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/supabase-js": "^2.98.0",
    "framer-motion": "^12.34.3",
    "next": "16.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
