# ---------------------------------------------------------------------------
# Runtime configuration for the app (Next.js on Vercel + Supabase).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. Changing one requires a rebuild and redeploy.
# ---------------------------------------------------------------------------

# Required. Without these the app builds but cannot reach any backend.
# The anon key is public by design — it ships in the client bundle and access
# is governed by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Hard gate on the draft form; defaults to closed when unset.
# Note: this is a build-time gate, so opening the draft currently needs a
# redeploy. Moving it into the season lock schedule is planned.
NEXT_PUBLIC_DRAFT_CLOSED=false

# Optional. Enables verbose client logging.
NEXT_PUBLIC_DEBUG_LOGS=false


# ---------------------------------------------------------------------------
# Server-side only. Used by the scripts in scripts/, never by the client.
# Never expose the service role key to the browser — it bypasses row-level
# security entirely.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---------------------------------------------------------------------------
# Legacy. Only needed to re-run the one-time PocketBase -> Supabase migration
# (scripts/migrate-pocketbase-to-supabase.mjs). PocketBase is no longer the
# production backend and these can be left unset for normal development.
# ---------------------------------------------------------------------------

# VITE_POCKETBASE_URL=https://api.traitorsfantasydraft.online
# POCKETBASE_ADMIN_EMAIL=you@example.com
# POCKETBASE_ADMIN_PASSWORD=
